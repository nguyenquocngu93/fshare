Dialogue: 0,0:00:00.00,0:00:04.60,Title,,0,0,0,,{\an8\pos(540,300)\fad(200,200)}VÌ SAO ONG CHẾT\NSAU KHI CHÍCH NGƯỜI?
Dialogue: 0,0:00:00.12,0:00:01.14,Sub,,0,0,0,,{\fad(90,90)}Vì sao con ong
Dialogue: 0,0:00:01.14,0:00:02.31,Sub,,0,0,0,,{\fad(90,90)}lại chết sau khi
Dialogue: 0,0:00:02.31,0:00:03.19,Sub,,0,0,0,,{\fad(90,90)}chích người?
Dialogue: 0,0:00:03.19,0:00:04.28,Sub,,0,0,0,,{\fad(90,90)}Câu trả lời nằm
Dialogue: 0,0:00:04.28,0:00:05.95,Sub,,0,0,0,,{\fad(90,90)}ở chiếc ngòi của nó.
Dialogue: 0,0:00:06.21,0:00:07.29,Sub,,0,0,0,,{\fad(90,90)}Ngòi của ong mật
Dialogue: 0,0:00:07.29,0:00:08.57,Sub,,0,0,0,,{\fad(90,90)}không hề trơn nhẵn.
Dialogue: 0,0:00:08.57,0:00:09.58,Sub,,0,0,0,,{\fad(90,90)}Nó có hàng chục
Dialogue: 0,0:00:09.58,0:00:10.93,Sub,,0,0,0,,{\fad(90,90)}chiếc ngạnh nhỏ quay
Dialogue: 0,0:00:10.93,0:00:12.15,Sub,,0,0,0,,{\fad(90,90)}ngược về phía sau,
Dialogue: 0,0:00:12.15,0:00:13.91,Sub,,0,0,0,,{\fad(90,90)}giống hệt một lưỡi câu.
Dialogue: 0,0:00:14.17,0:00:15.56,Sub,,0,0,0,,{\fad(90,90)}Khi chích côn trùng
Dialogue: 0,0:00:15.56,0:00:16.80,Sub,,0,0,0,,{\fad(90,90)}khác, lớp vỏ mỏng
Dialogue: 0,0:00:16.80,0:00:17.97,Sub,,0,0,0,,{\fad(90,90)}nên ong rút ngòi
Dialogue: 0,0:00:17.97,0:00:18.70,Sub,,0,0,0,,{\fad(90,90)}ra rất dễ.
Dialogue: 0,0:00:18.70,0:00:20.01,Sub,,0,0,0,,{\fad(90,90)}Nhưng da người thì
Dialogue: 0,0:00:20.01,0:00:21.32,Sub,,0,0,0,,{\fad(90,90)}dày và đàn hồi.
Dialogue: 0,0:00:21.58,0:00:23.13,Sub,,0,0,0,,{\fad(90,90)}Ngạnh cắm chặt vào
Dialogue: 0,0:00:23.13,0:00:24.42,Sub,,0,0,0,,{\fad(90,90)}da. Ong càng cố
Dialogue: 0,0:00:24.42,0:00:25.71,Sub,,0,0,0,,{\fad(90,90)}bay đi thì ngòi
Dialogue: 0,0:00:25.71,0:00:26.83,Sub,,0,0,0,,{\fad(90,90)}càng mắc kẹt,
Dialogue: 0,0:00:26.83,0:00:28.12,Sub,,0,0,0,,{\fad(90,90)}và cuối cùng nó
Dialogue: 0,0:00:28.12,0:00:29.41,Sub,,0,0,0,,{\fad(90,90)}bị đứt lìa khỏi
Dialogue: 0,0:00:29.41,0:00:30.57,Sub,,0,0,0,,{\fad(90,90)}cơ thể ong.
Dialogue: 0,0:00:30.83,0:00:32.15,Sub,,0,0,0,,{\fad(90,90)}Vết thương đó quá
Dialogue: 0,0:00:32.15,0:00:33.32,Sub,,0,0,0,,{\fad(90,90)}lớn, và chỉ vài
Dialogue: 0,0:00:33.32,0:00:34.02,Sub,,0,0,0,,{\fad(90,90)}phút sau,
Dialogue: 0,0:00:34.02,0:00:35.34,Sub,,0,0,0,,{\fad(90,90)}con ong không thể
Dialogue: 0,0:00:35.34,0:00:36.25,Sub,,0,0,0,,{\fad(90,90)}sống sót.
Dialogue: 0,0:00:36.51,0:00:37.50,Sub,,0,0,0,,{\fad(90,90)}Điều thú vị là
Dialogue: 0,0:00:37.50,0:00:38.56,Sub,,0,0,0,,{\fad(90,90)}chỉ ong mật thợ
Dialogue: 0,0:00:38.56,0:00:39.62,Sub,,0,0,0,,{\fad(90,90)}mới bị như vậy.
Dialogue: 0,0:00:39.62,0:00:40.47,Sub,,0,0,0,,{\fad(90,90)}Ong vò vẽ và
Dialogue: 0,0:00:40.47,0:00:41.46,Sub,,0,0,0,,{\fad(90,90)}ong bắp cày có
Dialogue: 0,0:00:41.46,0:00:42.17,Sub,,0,0,0,,{\fad(90,90)}ngòi trơn,
Dialogue: 0,0:00:42.17,0:00:43.58,Sub,,0,0,0,,{\fad(90,90)}nên chúng chích được
Dialogue: 0,0:00:43.58,0:00:44.85,Sub,,0,0,0,,{\fad(90,90)}nhiều lần mà chẳng
Dialogue: 0,0:00:44.85,0:00:45.77,Sub,,0,0,0,,{\fad(90,90)}hề hấn gì.
Dialogue: 0,0:00:46.03,0:00:47.04,Sub,,0,0,0,,{\fad(90,90)}Nói cách khác,
Dialogue: 0,0:00:47.04,0:00:48.41,Sub,,0,0,0,,{\fad(90,90)}chích người là hành
Dialogue: 0,0:00:48.41,0:00:49.57,Sub,,0,0,0,,{\fad(90,90)}động hy sinh của
Dialogue: 0,0:00:49.57,0:00:50.58,Sub,,0,0,0,,{\fad(90,90)}con ong để bảo
Dialogue: 0,0:00:50.58,0:00:51.30,Sub,,0,0,0,,{\fad(90,90)}vệ cả đàn.
Dialogue: 0,0:00:51.30,0:00:52.46,Sub,,0,0,0,,{\fad(90,90)}Nó đánh đổi mạng
Dialogue: 0,0:00:52.46,0:00:53.69,Sub,,0,0,0,,{\fad(90,90)}sống của mình cho
Dialogue: 0,0:00:53.69,0:00:54.98,Sub,,0,0,0,,{\fad(90,90)}tổ ong an toàn.
