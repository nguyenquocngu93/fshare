# TMDB API Read Access Token (Settings > API trên themoviedb.org).
# Token chỉ nằm ở backend, không được gửi xuống trình duyệt.
TMDB_API_TOKEN=
TMDB_LANGUAGE=vi-VN
TMDB_REGION=VN

# Android/Termux: ưu tiên IPv4 để tránh Wi-Fi/nhà mạng có IPv6 lỗi.
DNS_RESULT_ORDER=ipv4first

# Có thể dùng API Key v3 thay cho Read Access Token, nhưng không cần điền cả hai.
TMDB_API_KEY=

# Địa chỉ backend dùng khi chạy Node/Termux trực tiếp.
TORRSERVER_URL=http://127.0.0.1:8090

# Địa chỉ được mở trong trình duyệt khi bấm nút TorrServer.
TORRSERVER_PUBLIC_URL=http://127.0.0.1:8090

# Chỉ cần điền nếu TorrServer bật --httpauth.
TORRSERVER_USERNAME=
TORRSERVER_PASSWORD=

# Dung lượng được chọn trực tiếp trên giao diện; để trống = không giới hạn.
